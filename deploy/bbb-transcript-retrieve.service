[Unit]
Description=Retrieve finished BigBlueButton transcripts and summaries
After=network-online.target

[Service]
Type=oneshot
User=bigbluebutton
Group=bigbluebutton
EnvironmentFile=/etc/bigbluebutton/transcript-worker.env
ExecStart=/usr/bin/python3 /usr/local/bigbluebutton/core/scripts/post_publish/lib/bbb_retrieve.py
Nice=10
UMask=022

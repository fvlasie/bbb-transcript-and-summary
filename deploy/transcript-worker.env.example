# /etc/transcript-worker.env
# Mode 600, root:root. systemd reads this before dropping to the transcript user.

TRANSCRIPT_WORKER_TOKEN=replace-with-openssl-rand-hex-32
TRANSCRIPT_BIND=127.0.0.1
TRANSCRIPT_PORT=8787
TRANSCRIPT_DATA_DIR=/var/transcript-worker
TRANSCRIPT_MAX_UPLOAD_BYTES=1073741824
TRANSCRIPT_JOB_TIMEOUT_SECONDS=28800

HF_HOME=/var/transcript-worker/models
LLM_MODEL_FAMILY=gemma-4
# Optional: pin a GGUF you already downloaded instead of searching Hugging Face.
# LLAMA_MODEL_PATH=/var/transcript-worker/models/gemma-4-E4B-it-Q4_K_M.gguf
DEBUG_SUMMARY=0

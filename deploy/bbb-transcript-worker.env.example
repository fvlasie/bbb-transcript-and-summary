# /etc/bigbluebutton/transcript-worker.env
# Mode 640, root:bigbluebutton. The post-publish hook sources this file.

TRANSCRIPT_WORKER_URL=https://transcript.example.com
TRANSCRIPT_WORKER_TOKEN=replace-with-the-same-token-as-the-worker
TRANSCRIPT_JOBS_DIR=/var/bigbluebutton/transcript-jobs
TRANSCRIPT_MAX_ATTEMPTS=3
TRANSCRIPT_LOG_FILE=/var/log/bigbluebutton/post_publish_transcribe.log
